)$ci

c(
  `2.5%` = 2.50 + qnorm(0.025),
  `25%` = 2.50 + qnorm(0.25),
  `50%` = 2.50 + qnorm(0.50),
  `75%` = 2.50 + qnorm(0.75),
  `97.5%` = 2.50 + qnorm(0.975)
)


